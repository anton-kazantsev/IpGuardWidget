<Window x:Class="IpGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:IpGuard.Controls"
        Title="IP Guard"
        Width="392" Height="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown">

    <Grid x:Name="Root" Background="{x:Null}"
          MouseLeftButtonDown="Root_MouseLeftButtonDown"
          PreviewMouseDown="Root_PreviewMouseDown"
          MouseRightButtonUp="Root_MouseRightButtonUp">

        <!-- top to bottom: "what's new" panel, update banner, card -->
        <StackPanel x:Name="CardStack" HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- "what's new": hidden until the banner's button is clicked, height is animated in code -->
            <Grid x:Name="WhatsNewHost" Height="0" ClipToBounds="True" Width="360">
                <Border x:Name="WhatsNewPanel" Width="360" Height="348" CornerRadius="16"
                        Background="{StaticResource CardBrush}" BorderBrush="#14FFFFFF" BorderThickness="1"
                        Padding="19,17,19,19" VerticalAlignment="Top" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{Binding WhatsNewTitle}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#FFFFFF" LineHeight="18" LineStackingStrategy="BlockLineHeight"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding WhatsNewDate}" FontSize="11" Foreground="#7E7E88" Margin="0,4,0,0"
                                   LineHeight="14" LineStackingStrategy="BlockLineHeight" />
                        <Button Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left"
                                Margin="0,4,0,0" Click="OpenRelease_Click" ToolTip="Открыть страницу релиза на GitHub">
                            <TextBlock Text="Открыть на GitHub" FontSize="11" FontWeight="SemiBold"
                                       TextDecorations="Underline" LineHeight="14"
                                       LineStackingStrategy="BlockLineHeight" />
                        </Button>

                        <Rectangle Height="1" Fill="#14FFFFFF" Margin="0,12,0,0" />

                        <ScrollViewer Height="196" Margin="0,6,0,0" VerticalAlignment="Top"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Resources>
                                <!-- slim dark scrollbar instead of the default light WPF one -->
                                <Style TargetType="ScrollBar">
                                    <Setter Property="Width" Value="3" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ScrollBar">
                                                <Grid Background="#0FFFFFFF">
                                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                        <Track.Thumb>
                                                            <Thumb>
                                                                <Thumb.Template>
                                                                    <ControlTemplate TargetType="Thumb">
                                                                        <Border CornerRadius="1.5" Background="#47FFFFFF" />
                                                                    </ControlTemplate>
                                                                </Thumb.Template>
                                                            </Thumb>
                                                        </Track.Thumb>
                                                    </Track>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ScrollViewer.Resources>
                            <ItemsControl ItemsSource="{Binding Changes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="13" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="5" Height="5" Fill="#E2815F" VerticalAlignment="Top"
                                                     Margin="0,5.5,0,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding}" FontSize="11.5"
                                                       Foreground="#E7E7EA" TextWrapping="Wrap"
                                                       LineHeight="16" LineStackingStrategy="BlockLineHeight" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Grid Height="30" Margin="0,11,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource SmallPrimaryButtonStyle}" FontSize="11.5"
                                    Content="Скачать" Click="WhatsNewDownload_Click" />
                            <Button Grid.Column="2" Style="{StaticResource GhostButtonStyle}" FontSize="11.5"
                                    Content="Скрыть" Click="WhatsNewHide_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- update banner: shown only for a newer GitHub release, height is animated in code -->
            <Grid x:Name="BannerHost" Height="0" ClipToBounds="True" Width="360">
                <Border x:Name="UpdateBanner" Width="360" Height="72" CornerRadius="16"
                        Background="{StaticResource BannerBrush}" BorderThickness="1"
                        VerticalAlignment="Top" Margin="0,0,0,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="#33E2815F" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Error">
                                    <Setter Property="BorderBrush" Value="#4DFF9F0A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid Margin="11">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="18" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="24" />
                        </Grid.RowDefinitions>

                        <Grid Height="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                            </Grid.ColumnDefinitions>

                            <!-- icon: download arrow for "available" and "downloading" -->
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Available">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Downloading">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Border CornerRadius="8" Background="{StaticResource AccentBrush}" />
                                <Canvas Width="7" Height="10.5" HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Rectangle Width="1.4" Height="6" Fill="#FFFFFF" Canvas.Left="2.8" />
                                    <Path Data="M0,6 L7,6 L3.5,10.5 Z" Fill="#FFFFFF" />
                                </Canvas>
                            </Grid>

                            <!-- icon: success check for "ready to restart" -->
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Ready">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Border CornerRadius="8" Background="#34C759" />
                                <Path Data="M4.2,8.2 L7,11 L11.8,5.2" Width="12" Height="12" Stretch="None"
                                      Stroke="#FFFFFF" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>

                            <!-- icon: warning for a failed download -->
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Error">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Border CornerRadius="8" Background="#FF9F0A" />
                                <TextBlock Text="!" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0,-1,0,0" />
                            </Grid>

                            <TextBlock Grid.Column="1" Text="{Binding UpdateTitle}" FontSize="12.5"
                                       FontWeight="SemiBold" Margin="8,0,8,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Error">
                                                <Setter Property="Foreground" Value="#FFC24D" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- postpone: only while the update is just "available" -->
                            <Button Grid.Column="2" Width="16" Height="16" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Click="UpdatePostpone_Click"
                                    ToolTip="Скрыть до следующей версии">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource CloseIconButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Available">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="×" FontSize="12" Foreground="#A9A9B0"
                                           LineHeight="12" LineStackingStrategy="BlockLineHeight" />
                            </Button>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ProgressBar Width="100" Height="4" Margin="0,0,10,0" VerticalAlignment="Center"
                                         Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}"
                                         Background="#29FFFFFF" Foreground="#E2815F" BorderThickness="0"
                                         Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}"
                                                CornerRadius="2" ClipToBounds="True">
                                            <Border x:Name="PART_Indicator"
                                                    Background="{TemplateBinding Foreground}"
                                                    CornerRadius="2" HorizontalAlignment="Left" />
                                        </Border>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>

                            <TextBlock Grid.Column="1" Text="{Binding UpdateSubtitle}" FontSize="10.5"
                                       Foreground="#B99C8F" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Width="56" Height="22" Content="Скачать" Click="UpdatePrimary_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SmallPrimaryButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Available">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Width="70" Height="22" Margin="8,0,0,0" Content="Что нового"
                                        Click="UpdateWhatsNew_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="FontSize" Value="10.5" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Available">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Width="56" Height="22" Content="Отмена" Click="UpdatePrimary_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="FontSize" Value="10.5" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Downloading">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Width="100" Height="22" Content="Перезапустить" Click="UpdatePrimary_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SmallPrimaryButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Ready">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Width="86" Height="22" Content="Повторить" Click="UpdatePrimary_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource WarningButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Error">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="CardFrame">
                <!-- soft shadow behind the card (drawn separately, because the card clips its content) -->
                <Border x:Name="ShadowLayer" Width="360" Height="288" CornerRadius="16"
                        Background="#17181D" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.55" Color="#000000" />
                    </Border.Effect>
                </Border>

                <controls:RoundedClipBorder x:Name="Card" Width="360" Height="288"
                                            CornerRadius="16" BorderThickness="1" BorderBrush="#14FFFFFF"
                                            Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="{StaticResource CardBrush}">

                    <StackPanel>

                        <!-- header: left group is 60 px wide (logo 26 + gap 8 + check 26), the title stays centred -->
                        <Grid Height="26">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Grid Width="26" Height="26">
                                    <Border CornerRadius="8" Background="{StaticResource LogoBrush}" />
                                    <TextBlock Text="&gt;_" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                               Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="0,1,0,0" />
                                </Grid>

                                <!-- manual update check: logo gradient fill and a white icon once an update is known -->
                                <Button Width="26" Height="26" Margin="8,0,0,0" Click="CheckUpdates_Click"
                                        ToolTip="Проверить обновления" Focusable="False" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource HeaderIconButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Value="True"
                                                             Binding="{Binding Update.HasUpdate, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <Setter Property="Background" Value="{StaticResource LogoBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Value="True"
                                                             Binding="{Binding Update.IsChecking, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <Setter Property="Opacity" Value="0.5" />
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Grid Width="26" Height="26">
                                        <Canvas Width="14" Height="14" HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <Canvas.Resources>
                                                <!-- refresh ring: light gray, white on the gradient fill -->
                                                <Style x:Key="RingPath" TargetType="Path">
                                                    <Setter Property="Stroke" Value="#E7E7EA" />
                                                    <Setter Property="StrokeThickness" Value="1.5" />
                                                    <Setter Property="StrokeStartLineCap" Value="Round" />
                                                    <Setter Property="StrokeEndLineCap" Value="Round" />
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True"
                                                                     Binding="{Binding Update.HasUpdate, RelativeSource={RelativeSource AncestorType=Window}}">
                                                            <Setter Property="Stroke" Value="#FFFFFF" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                                <Style x:Key="TipPath" TargetType="Path">
                                                    <Setter Property="Fill" Value="#E7E7EA" />
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True"
                                                                     Binding="{Binding Update.HasUpdate, RelativeSource={RelativeSource AncestorType=Window}}">
                                                            <Setter Property="Fill" Value="#FFFFFF" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Canvas.Resources>
                                            <!-- ring with a gap at the top right -->
                                            <Path Style="{StaticResource RingPath}"
                                                  Data="M11.02,3.63 A5.25,5.25 0 1 1 6.54,1.77" />
                                            <!-- triangular arrow at the end of the ring -->
                                            <Path Style="{StaticResource TipPath}" Data="M6.2,0.8 L9.4,2.2 L6.2,3.8 Z" />
                                        </Canvas>
                                        <!-- dot: an update is known, hangs over the rounded corner -->
                                        <Ellipse Width="6" Height="6" Fill="#E2815F" Stroke="#1A1A20"
                                                 StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                 Margin="0,-2,-2,0"
                                                 Visibility="{Binding Update.HasUpdate, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="CLAUDE CODE" FontSize="10.5" FontWeight="SemiBold" Foreground="#FFFFFF"
                                           LineHeight="12" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="IP GUARD" FontSize="9" Foreground="#7B7B85"
                                               LineHeight="10" LineStackingStrategy="BlockLineHeight" />
                                    <TextBlock Text="v1.2" FontSize="9" Foreground="#6E6E78" Margin="6,0,0,0"
                                               LineHeight="10" LineStackingStrategy="BlockLineHeight" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border Height="20" CornerRadius="10" Padding="9,0"
                                        Background="{Binding PillBackground}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="5" Height="5" Fill="{Binding PillDotBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding PillText}" Margin="4,0,0,0" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{Binding PillTextBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Button x:Name="CollapseButton" Width="26" Height="26" Margin="8,0,0,0"
                                        Style="{StaticResource CollapseButtonStyle}" Click="CollapseButton_Click"
                                        ToolTip="Свернуть в трей">
                                    <Path Data="M0,0 L5.5,5.5 L11,0" Width="11" Height="5.5" Stretch="None"
                                          Stroke="#FFFFFF" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- IP block -->
                        <Grid Height="51" Margin="0,14,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="15" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="32" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock Text="ТЕКУЩИЙ IP" FontSize="11" FontWeight="SemiBold" Foreground="#7E7E88"
                                           VerticalAlignment="Center" />
                                <Border HorizontalAlignment="Right" Height="15" MinWidth="28" CornerRadius="4"
                                        Background="#12FFFFFF" Padding="6,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding IpFamily}" FontSize="9" Foreground="#A3A3AC"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <Grid Grid.Row="2">
                                <TextBlock Text="{Binding IpAddress}" FontSize="27" FontWeight="SemiBold" Foreground="#FFFFFF"
                                           VerticalAlignment="Center" LineHeight="32" LineStackingStrategy="BlockLineHeight"
                                           Visibility="{Binding ShowContent, Converter={StaticResource BoolToVis}}" />

                                <Rectangle Width="208" Height="14" RadiusX="7" RadiusY="7"
                                           Fill="{StaticResource SkeletonBrush}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center"
                                           Visibility="{Binding ShowSkeleton, Converter={StaticResource BoolToVis}}">
                                    <Rectangle.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0.45" To="1" Duration="0:0:0.9" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Rectangle.Triggers>
                                </Rectangle>

                                <Button x:Name="CopyButton" Width="22" Height="22" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Focusable="False" Click="CopyButton_Click"
                                        ToolTip="Скопировать IP"
                                        Visibility="{Binding CanCopyIp, Converter={StaticResource BoolToVis}}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid Background="Transparent">
                                                <Canvas Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path x:Name="IconBack"
                                                          Data="M3.8,3.2 V2 A1.2,1.2 0 0 1 5,0.8 H11 A1.2,1.2 0 0 1 12.2,2 V8 A1.2,1.2 0 0 1 11,9.2 H9.2"
                                                          Stroke="#A3A3AC" StrokeThickness="1.25"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    <Rectangle x:Name="IconFront" Canvas.Left="0.8" Canvas.Top="3.8"
                                                               Width="8.4" Height="8.4" RadiusX="1.4" RadiusY="1.4"
                                                               Stroke="#A3A3AC" StrokeThickness="1.25" />
                                                </Canvas>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="IconBack" Property="Stroke" Value="#FFFFFF" />
                                                    <Setter TargetName="IconFront" Property="Stroke" Value="#FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Grid>

                        <!-- country -->
                        <Grid Height="30" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="22" />
                            </Grid.ColumnDefinitions>

                            <controls:RoundedClipBorder Width="44" Height="30" CornerRadius="5" Background="#0FFFFFFF">
                                <controls:FlagView CountryCode="{Binding CountryCode}" />
                            </controls:RoundedClipBorder>

                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CountryName}" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF"
                                           LineHeight="18" LineStackingStrategy="BlockLineHeight"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding CountrySub}" FontSize="12" Foreground="#7E7E88"
                                           LineHeight="12" LineStackingStrategy="BlockLineHeight" Margin="0,1,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Border Grid.Column="2" Width="22" Height="22" CornerRadius="11"
                                    Background="{Binding BadgeBackground}" VerticalAlignment="Center">
                                <Grid>
                                    <Path Data="M1.5,4.6 L3.8,6.9 L8,1.9" Width="9" Height="8" Stretch="None"
                                          Stroke="#34C759" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="{Binding ShowCheck, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="!" FontSize="11" FontWeight="Bold" Foreground="#FFC24D"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding ShowWarn, Converter={StaticResource BoolToVis}}" />
                                    <Path Width="18" Height="18" Stretch="None"
                                          Data="M9,1.2 A7.8,7.8 0 1 1 3.1,3.6"
                                          Stroke="#8A8A93" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5"
                                          Visibility="{Binding ShowSpinner, Converter={StaticResource BoolToVis}}">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="SpinnerRotate" />
                                        </Path.RenderTransform>
                                        <Path.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                                         Storyboard.TargetProperty="Angle"
                                                                         From="0" To="360" Duration="0:0:0.9" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Path.Triggers>
                                    </Path>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- notice (VPN blocked / Claude Code warning / launch error): height is animated in code -->
                        <Grid x:Name="NoticeHost" Height="0" ClipToBounds="True">
                            <Border x:Name="NoticeCard" Height="{Binding NoticeHeight}" Margin="0,14,0,0" CornerRadius="10"
                                    Background="{Binding NoticeBackground}" VerticalAlignment="Top">
                                <Grid Margin="11,0,9,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="16" Height="16" CornerRadius="8"
                                            Background="{Binding NoticeIconBackground}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NoticeGlyph}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{Binding NoticeIconForeground}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="0,-1,0,0" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NoticeTitle}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{Binding NoticeTitleBrush}" LineHeight="14"
                                                   LineStackingStrategy="BlockLineHeight"
                                                   TextWrapping="Wrap" TextTrimming="None" />
                                        <TextBlock Text="{Binding NoticeBody}" FontSize="11.5"
                                                   Foreground="{Binding NoticeTextBrush}"
                                                   LineHeight="13" LineStackingStrategy="BlockLineHeight" Margin="0,1,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- shell picker -->
                        <Grid Height="26" Margin="0,8,0,0">
                            <Button x:Name="ShellButton" HorizontalAlignment="Left" Style="{StaticResource ShellChipStyle}"
                                    Click="ShellButton_Click" ToolTip="Оболочка для запуска Claude Code">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M0,0 L4,4 L8,0" Width="8" Height="4" Stretch="None"
                                          Stroke="#A9A9B0" StrokeThickness="1.4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="ShellChevronRotate" Angle="0" />
                                        </Path.RenderTransform>
                                    </Path>
                                    <TextBlock x:Name="ShellLabel" Margin="6,0,0,0" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="#E7E7EA" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <TextBlock Text="ОБОЛОЧКА" FontSize="10" FontWeight="SemiBold" Foreground="#7E7E88"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <!-- primary action -->
                        <Button x:Name="RunButton" Height="46" Margin="0,8,0,0" Style="{StaticResource RunButtonStyle}"
                                IsEnabled="{Binding IsButtonEnabled}" Click="RunButton_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&gt;_" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                           Foreground="{Binding ButtonForeground}" Margin="0,1,6,0" VerticalAlignment="Center"
                                           Visibility="{Binding ShowPromptIcon, Converter={StaticResource BoolToVis}}" />
                                <Grid Width="12" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"
                                      Visibility="{Binding ShowLockIcon, Converter={StaticResource BoolToVis}}">
                                    <Path Data="M3,6.5 V4.5 A3,3 0 0 1 9,4.5 V6.5"
                                          Stroke="{Binding ButtonForeground}" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Border Width="10" Height="7.5" CornerRadius="1.5"
                                            Background="{Binding ButtonForeground}" VerticalAlignment="Bottom" />
                                </Grid>
                                <TextBlock Text="{Binding ButtonLabel}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{Binding ButtonForeground}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- footer: status text on the left, the only action is the refresh link -->
                        <Grid Height="16" Margin="0,9,0,0">
                            <TextBlock Text="{Binding FooterLeft}" FontSize="11" Foreground="#6D6D77"
                                       VerticalAlignment="Center" />
                            <Button Style="{StaticResource LinkButtonStyle}" Content="{Binding FooterLink}"
                                    HorizontalAlignment="Right" Foreground="#7FB2E5" VerticalAlignment="Center"
                                    IsEnabled="{Binding IsFooterLinkEnabled}" Click="RefreshLink_Click" />
                        </Grid>

                    </StackPanel>
                </controls:RoundedClipBorder>
            </Grid>

        </StackPanel>

        <!-- shell flyout: opens to the left of the chip, over the desktop -->
        <Popup x:Name="ShellPopup" Placement="Absolute" StaysOpen="True" AllowsTransparency="True"
               PopupAnimation="Fade" PlacementTarget="{Binding ElementName=ShellButton}">
            <Border Width="178" CornerRadius="10" Background="#31313A" BorderBrush="#24FFFFFF" BorderThickness="1"
                    Padding="6">
                <StackPanel x:Name="ShellPopupItems" />
            </Border>
        </Popup>
    </Grid>
</Window>
