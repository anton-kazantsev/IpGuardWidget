<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>IpGuardWidget</AssemblyName>
    <RootNamespace>IpGuard</RootNamespace>
    <AssemblyTitle>IP Guard</AssemblyTitle>
    <Product>IP Guard</Product>
    <Description>IP Guard — widget for Windows 10/11 that checks your IP country and launches Claude Code.</Description>
    <Version>1.2.0</Version>
    <FileVersion>1.2.0.0</FileVersion>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ReadyToRun>true</ReadyToRun>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\tray-on.ico" />
    <Resource Include="Assets\tray-off.ico" />
  </ItemGroup>

</Project>
